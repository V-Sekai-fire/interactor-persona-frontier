"@context":
  VSEKAI: "https://v-sekai.org/"
  domain: "VSEKAI:planning/domain/"
"@type": "domain:Definition"
name: artifacts_mmo
description: "The primitives of an API-first MMO: one action per operation the player may act with, a character is a slot, a fact is set and never incremented. Generated by tools/mmo/domain.exs from the protocol document; durations are unmeasured until experience reports replace them."
version: "0.1.0"
source: interactor-persona-frontier
enums:
  skill:
    - alchemy
    - cooking
    - fishing
    - gearcrafting
    - jewelrycrafting
    - mining
    - weaponcrafting
    - woodcutting
  slot:
    - weapon
    - shield
    - helmet
    - body_armor
    - leg_armor
    - boots
    - ring1
    - ring2
    - amulet
    - artifact1
    - artifact2
    - artifact3
    - utility1
    - utility2
    - bag
    - rune
variables:
