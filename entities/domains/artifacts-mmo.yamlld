    name: equipped
    type: int
actions:
  buy:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
      - eval:
          a:
            pointer: "/inv_full/[c]"
            type: pointer/get
          b: 0
          type: math/eq
      - pointer/set: "/have/[c]/[code]"
        value:
          param: after
    description: "The action_npc_buy operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
      - code
      - quantity
      - after
    x-duration: unmeasured
    x-operation: action_npc_buy
  cancel-task:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
      - eval:
          a:
            pointer: "/task/[c]"
            type: pointer/get
          b: 1
          type: math/ge
      - pointer/set: "/task/[c]"
        value: 0
    description: "The action_task_cancel operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
    x-duration: unmeasured
    x-operation: action_task_cancel
  complete-task:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
      - eval:
          a:
            pointer: "/task/[c]"
            type: pointer/get
          b: 1
          type: math/ge
      - pointer/set: "/task/[c]"
        value: 0
    description: "The action_task_complete operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
    x-duration: unmeasured
    x-operation: action_task_complete
  craft:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
      - eval:
          a:
            pointer: "/skill/[c]/[skill]"
            type: pointer/get
          b:
            param: level
          type: math/ge
      - eval:
          a:
            pointer: "/inv_full/[c]"
            type: pointer/get
          b: 0
          type: math/eq
      - pointer/set: "/have/[c]/[code]"
        value:
          param: after
    description: "The action_crafting operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
      - enum: skill
        name: skill
      - level
      - code
      - quantity
      - after
    x-duration: unmeasured
    x-operation: action_crafting
  deposit-gold:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
    description: "The action_bank_deposit_gold operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
      - quantity
    x-duration: unmeasured
    x-operation: action_bank_deposit_gold
  deposit-item:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
      - pointer/set: "/inv_full/[c]"
        value: 0
    description: "The action_bank_deposit_item operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
      - code
      - quantity
    x-duration: unmeasured
    x-operation: action_bank_deposit_item
  equip:
    body:
      - eval:
          a:
            pointer: "/slot_full/[c]/[slot]"
            type: pointer/get
          b: 0
          type: math/eq
      - pointer/set: "/slot_full/[c]/[slot]"
        value: 1
      - pointer/set: "/equipped/[c]/[slot]"
        value:
          param: code
    description: "The action_equip operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - code
      - enum: slot
        name: slot
    x-duration: unmeasured
    x-operation: action_equip
  fight:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
      - eval:
          a:
            pointer: "/inv_full/[c]"
            type: pointer/get
          b: 0
          type: math/eq
      - pointer/set: "/hp_full/[c]"
        value: 0
    description: "The action_fight operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
    x-duration: unmeasured
    x-operation: action_fight
  gather:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
      - eval:
          a:
            pointer: "/skill/[c]/[skill]"
            type: pointer/get
          b:
            param: level
          type: math/ge
      - eval:
          a:
            pointer: "/inv_full/[c]"
            type: pointer/get
          b: 0
          type: math/eq
      - pointer/set: "/have/[c]/[code]"
        value:
          param: after
    description: "The action_gathering operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
      - enum: skill
        name: skill
      - level
      - code
      - after
    x-duration: unmeasured
    x-operation: action_gathering
  move:
    body:
      - pointer/set: "/x/[c]"
        value:
          param: x
      - pointer/set: "/y/[c]"
        value:
          param: "y"
    description: "The action_move operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - x
      - "y"
    x-duration: unmeasured
    x-operation: action_move
  new-task:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
      - eval:
          a:
            pointer: "/task/[c]"
            type: pointer/get
          b: 0
          type: math/eq
      - pointer/set: "/task/[c]"
        value: 1
    description: "The action_task_new operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
    x-duration: unmeasured
    x-operation: action_task_new
  recycle:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
      - eval:
          a:
            pointer: "/skill/[c]/[skill]"
            type: pointer/get
          b:
            param: level
          type: math/ge
      - eval:
          a:
            pointer: "/inv_full/[c]"
            type: pointer/get
          b: 0
          type: math/eq
    description: "The action_recycling operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
      - enum: skill
        name: skill
      - level
      - code
      - quantity
    x-duration: unmeasured
    x-operation: action_recycling
  rest:
    body:
      - pointer/set: "/hp_full/[c]"
        value: 1
    description: "The action_rest operation for the character in the slot c."
    duration: PT5S
    params:
      - c
    x-duration: unmeasured
    x-operation: action_rest
  sell:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
    description: "The action_npc_sell operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
      - code
      - quantity
    x-duration: unmeasured
    x-operation: action_npc_sell
  unequip:
    body:
      - eval:
          a:
            pointer: "/slot_full/[c]/[slot]"
            type: pointer/get
          b: 1
          type: math/eq
      - pointer/set: "/slot_full/[c]/[slot]"
        value: 0
    description: "The action_unequip operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - enum: slot
        name: slot
    x-duration: unmeasured
    x-operation: action_unequip
  use:
    body: []
    description: "The action_use operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - code
      - quantity
    x-duration: unmeasured
    x-operation: action_use
  withdraw-gold:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
    description: "The action_bank_withdraw_gold operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
      - quantity
    x-duration: unmeasured
    x-operation: action_bank_withdraw_gold
  withdraw-item:
    body:
      - eval:
          a:
            pointer: "/x/[c]"
            type: pointer/get
          b:
            param: tx
          type: math/eq
      - eval:
          a:
            pointer: "/y/[c]"
            type: pointer/get
          b:
            param: ty
          type: math/eq
      - eval:
          a:
            pointer: "/inv_full/[c]"
            type: pointer/get
          b: 0
          type: math/eq
      - pointer/set: "/have/[c]/[code]"
        value:
          param: after
    description: "The action_bank_withdraw_item operation for the character in the slot c."
    duration: PT5S
    params:
      - c
      - tx
      - ty
      - code
      - quantity
      - after
    x-duration: unmeasured
    x-operation: action_bank_withdraw_item
methods:
  buy-at:
    alternatives:
      - check: []
        name: go-and-act
        subtasks:
          - - go-to
            - param: c
            - param: tx
            - param: ty
          - - buy
            - param: c
            - param: tx
            - param: ty
            - param: code
            - param: quantity
            - param: after
    params:
      - c
      - tx
      - ty
      - code
      - quantity
      - after
  cancel-task-at:
    alternatives:
      - check: []
        name: go-and-act
        subtasks:
          - - go-to
            - param: c
            - param: tx
            - param: ty
          - - cancel-task
            - param: c
            - param: tx
            - param: ty
    params:
      - c
      - tx
      - ty
  complete-task-at:
    alternatives:
      - check: []
        name: go-and-act
        subtasks:
          - - go-to
            - param: c
            - param: tx
            - param: ty
          - - complete-task
            - param: c
            - param: tx
            - param: ty
    params:
      - c
      - tx
      - ty
  craft-at:
    alternatives:
      - check: []
        name: go-and-act
        subtasks:
          - - go-to
            - param: c
            - param: tx
            - param: ty
          - - craft
            - param: c
            - param: tx
            - param: ty
            - param: skill
            - param: level
            - param: code
            - param: quantity
            - param: after
    params:
      - c
      - tx
      - ty
      - enum: skill
        name: skill
      - level
      - code
      - quantity
      - after
  deposit-gold-at:
    alternatives:
      - check: []
        name: go-and-act
        subtasks:
          - - go-to
            - param: c
            - param: tx
            - param: ty
          - - deposit-gold
            - param: c
            - param: tx
            - param: ty
            - param: quantity
    params:
      - c
      - tx
      - ty
      - quantity
  deposit-item-at:
    alternatives:
      - check: []
        name: go-and-act
        subtasks:
          - - go-to
            - param: c
            - param: tx
            - param: ty
          - - deposit-item
            - param: c
            - param: tx
            - param: ty
            - param: code
            - param: quantity
    params:
      - c
      - tx
      - ty
      - code
      - quantity
  fight-at:
    alternatives:
      - check: []
        name: go-and-act
        subtasks:
          - - go-to
            - param: c
            - param: tx
            - param: ty
          - - fight
            - param: c
            - param: tx
            - param: ty
    params:
      - c
      - tx
      - ty
  gather-at:
    alternatives:
      - check: []
        name: go-and-act
        subtasks:
          - - go-to
            - param: c
            - param: tx
            - param: ty
          - - gather
            - param: c
            - param: tx
            - param: ty
            - param: skill
            - param: level
            - param: code
            - param: after
    params:
      - c
      - tx
      - ty
      - enum: skill
        name: skill
      - level
      - code
      - after
  go-to:
    alternatives:
      - check:
          - eval:
              a:
                pointer: "/x/[c]"
                type: pointer/get
              b:
                param: x
              type: math/eq
          - eval:
              a:
                pointer: "/y/[c]"
                type: pointer/get
              b:
                param: "y"
              type: math/eq
        name: there
        subtasks: []
      - check: []
        name: move
        subtasks:
          - - move
            - param: c
            - param: x
            - param: "y"
    params:
      - c
      - x
      - "y"
  heal:
    alternatives:
      - check:
          - eval:
              a:
                pointer: "/hp_full/[c]"
                type: pointer/get
              b: 1
              type: math/eq
        name: full
        subtasks: []
      - check: []
        name: rest
        subtasks:
          - - rest
            - param: c
    params:
      - c
  new-task-at:
    alternatives:
      - check: []
        name: go-and-act
        subtasks:
          - - go-to
            - param: c
            - param: tx
            - param: ty
          - - new-task
            - param: c
            - param: tx
            - param: ty
    params:
      - c
      - tx
      - ty
  recycle-at:
    alternatives:
      - check: []
        name: go-and-act
        subtasks:
          - - go-to
            - param: c
            - param: tx
            - param: ty
          - - recycle
            - param: c
            - param: tx
            - param: ty
            - param: skill
            - param: level
            - param: code
            - param: quantity
    params:
      - c
      - tx
      - ty
      - enum: skill
        name: skill
      - level
      - code
      - quantity
  sell-at:
    alternatives:
      - check: []
        name: go-and-act
        subtasks:
          - - go-to
            - param: c
            - param: tx
            - param: ty
          - - sell
            - param: c
            - param: tx
            - param: ty
            - param: code
            - param: quantity
    params:
      - c
      - tx
      - ty
      - code
