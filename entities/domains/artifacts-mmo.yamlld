actions:
  buy:
    body:
      - eval:
          a:
            pointer: "/at/[c]"
            type: pointer/get
          b:
            param: place
          type: math/eq
      - eval:
          a:
            pointer: "/inv_full/[c]"
            type: pointer/get
          b: 0
          type: math/eq
      - pointer/set: "/have/[c]/[item]"
        value:
          param: after
    description: "The action_npc_buy operation."
    duration: PT5S
    params:
      - enum: char
        name: c
      - enum: tile
        name: place
      - enum: item
        name: item
      - quantity
      - after
    x-duration: unmeasured
    x-operation: action_npc_buy
  cancel-task:
    body:
      - eval:
          a:
            pointer: "/at/[c]"
            type: pointer/get
          b:
            param: place
          type: math/eq
      - eval:
          a:
            pointer: "/task/[c]"
            type: pointer/get
          b: 1
          type: math/ge
      - pointer/set: "/task/[c]"
        value: 0
    description: "The action_task_cancel operation."
    duration: PT5S
    params:
      - enum: char
        name: c
      - enum: tile
        name: place
    x-duration: unmeasured
    x-operation: action_task_cancel
  complete-task:
    body:
      - eval:
          a:
            pointer: "/at/[c]"
            type: pointer/get
          b:
            param: place
          type: math/eq
      - eval:
          a:
            pointer: "/task/[c]"
            type: pointer/get
          b: 1
          type: math/ge
      - pointer/set: "/task/[c]"
        value: 0
    description: "The action_task_complete operation."
    duration: PT5S
    params:
      - enum: char
        name: c
      - enum: tile
        name: place
    x-duration: unmeasured
    x-operation: action_task_complete
  craft:
    body:
      - eval:
          a:
            pointer: "/at/[c]"
            type: pointer/get
          b:
            param: place
          type: math/eq
      - eval:
          a:
            pointer: "/skill/[c]/[skill]"
            type: pointer/get
          b:
            param: level
          type: math/ge
      - eval:
          a:
            pointer: "/inv_full/[c]"
            type: pointer/get
          b: 0
          type: math/eq
      - pointer/set: "/have/[c]/[item]"
        value:
          param: after
    description: "The action_crafting operation."
    duration: PT5S
    params:
      - enum: char
        name: c
      - enum: tile
        name: place
      - enum: skill
        name: skill
      - level
      - enum: item
        name: item
      - quantity
      - after
    x-duration: unmeasured
    x-operation: action_crafting
  deposit-gold:
    body:
      - eval:
          a:
            pointer: "/at/[c]"
            type: pointer/get
          b:
            param: place
          type: math/eq
    description: "The action_bank_deposit_gold operation."
    duration: PT5S
    params:
      - enum: char
        name: c
      - enum: tile
        name: place
      - quantity
    x-duration: unmeasured
    x-operation: action_bank_deposit_gold
  deposit-item:
    body:
      - eval:
          a:
            pointer: "/at/[c]"
            type: pointer/get
          b:
            param: place
          type: math/eq
      - pointer/set: "/inv_full/[c]"
        value: 0
    description: "The action_bank_deposit_item operation."
    duration: PT5S
    params:
      - enum: char
        name: c
      - enum: tile
        name: place
      - enum: item
        name: item
      - quantity
    x-duration: unmeasured
    x-operation: action_bank_deposit_item
  equip:
    body:
      - eval:
          a:
            pointer: "/slot_full/[c]/[slot]"
            type: pointer/get
          b: 0
          type: math/eq
      - pointer/set: "/slot_full/[c]/[slot]"
        value: 1
      - pointer/set: "/equipped/[c]/[slot]"
        value:
          param: item
    description: "The action_equip operation."
    duration: PT5S
    params:
      - enum: char
        name: c
      - enum: item
        name: item
      - enum: slot
        name: slot
    x-duration: unmeasured
    x-operation: action_equip
  fight:
