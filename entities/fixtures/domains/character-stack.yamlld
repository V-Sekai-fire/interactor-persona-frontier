description: "The look-dev pipeline for characters, props and worlds, all GPU-skinned: settle-<subject>-N holds when the stages it requires are settled and the repositories it draws on are acquired. Requirements and durations are learned from experience reports and kept in the store; the authored data is the seed files in seeds/."
methods:
  reach-character-body:
    alternatives:
      - check:
          - eval:
              a:
                pointer: /stage/character-body
                type: pointer/get
              b: 1
              type: math/ge
        name: held
        subtasks: []
      - name: settle
        subtasks:
          - - reach-character-image-to-3d
          - - reach-token-interactor-anny-fit
          - - reach-token-interactor-headfit
          - - reach-token-contract-anny-kernels
          - - reach-token-sinew-mocap-measure
          - - settle-character-body
    params: []
  reach-character-face-voice:
    alternatives:
      - check:
          - eval:
              a:
                pointer: /stage/character-face-voice
                type: pointer/get
              b: 1
              type: math/ge
        name: held
        subtasks: []
      - name: settle
        subtasks:
          - - reach-character-body
          - - reach-character-gpu-skin
          - - reach-token-interactor-headfit
          - - reach-token-sherpa-onnx-zipformer
          - - reach-token-interactor-voice
          - - reach-token-silero-vad
          - - settle-character-face-voice
    params: []
  reach-character-garments:
    alternatives:
      - check:
          - eval:
              a:
                pointer: /stage/character-garments
                type: pointer/get
              b: 1
              type: math/ge
        name: held
